# --- Build Directories ---
# Ignores all 'build' folders at any depth (root, HFT/build, Emulator/build, etc.)
build/
bin/
obj/

# --- CMake Artifacts ---
# Ignores files generated by CMake that might be outside of a build folder
CMakeFiles/
CMakeCache.txt
CMakeConfigureLog.yaml
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# --- Compiled Binaries & Libraries ---
# Static and dynamic libraries
*.a
*.so
*.dylib
*.lib
*.dll

# Generic executable names found in your tree
app
graphics
data
main
test

# Object files and dependency files
*.o
*.obj
*.d

# --- Project Specific Artifacts ---
# RISC-V binary blobs generated from your assembly/C tests
src/RISC-V_Emulator/src/assembly/**/*.bin
src/RISC-V_Emulator/src/assembly/**/*.o

# --- System & IDE Files ---
.DS_Store
.cache/
.vscode/
.idea/
*.swp
*.swo